# Gemini API credentials are separate from Gmail OAuth credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Download an OAuth Desktop client JSON into ./credentials (never commit it).
GOOGLE_CLIENT_SECRETS_FILE=credentials/client_secret.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose

APP_ENV=development
DATABASE_PATH=data/ned_agent.sqlite3
GMAIL_QUERY=in:inbox newer_than:30d
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=25
LOG_LEVEL=INFO
POLICY_FILE=policies/company_policy.md
CATEGORIES=Billing,Refund,Technical Support,Account Access,Order or Service Issue,General Inquiry,Feedback,Security or Privacy,Legal,Other
